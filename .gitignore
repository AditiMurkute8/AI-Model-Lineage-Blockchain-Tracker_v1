# ==============================================================================
# AI Model Lineage & Blockchain Tracker - Production Git Ignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python Bytecode, Caches & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

.venv/
venv/
env/
ENV/

*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 2. Node.js / Frontend Dependencies & Build Outputs
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log

dist/
dist-ssr/
build/
.next/
coverage/

# ------------------------------------------------------------------------------
# 3. Environment Variables / Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*

!.env.example

*.pem
*.key
credentials.*
secrets.*

# ------------------------------------------------------------------------------
# 4. IDE / OS Files
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.iml
*.ipr
*.iws

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

ehthumbs.db
Thumbs.db
desktop.ini

*.swp
*.swo

# ------------------------------------------------------------------------------
# 5. Temporary / Runtime Files
# ------------------------------------------------------------------------------
*.tmp
*.temp
*.log
*.bak

temp_exp_*.json
temp_experiment.json
temp_predict_*.json

# ------------------------------------------------------------------------------
# 6. PyDriller Cloned Repositories
# ------------------------------------------------------------------------------
ai-model-lineage-tracker/dataset/git_commits/repos/

# ------------------------------------------------------------------------------
# 7. Legacy Model Artifacts
#
# Keep the old/general ML model history out of Git.
# Git-Commit Intelligence has its own explicitly tracked model directory.
# ------------------------------------------------------------------------------
ai-model-lineage-tracker/ai_model/model_versions/*

!ai-model-lineage-tracker/ai_model/model_versions/git-commit-intelligence/
!ai-model-lineage-tracker/ai_model/model_versions/git-commit-intelligence/**

# ------------------------------------------------------------------------------
# 8. Git-Commit Intelligence — Preserve Model Lineage Artifacts
# ------------------------------------------------------------------------------
!ai-model-lineage-tracker/ai_model/git_intelligence/
!ai-model-lineage-tracker/ai_model/git_intelligence/**

!ai-model-lineage-tracker/ai_model/model_versions/git-commit-intelligence/
!ai-model-lineage-tracker/ai_model/model_versions/git-commit-intelligence/**

# ------------------------------------------------------------------------------
# 9. Git-Commit Intelligence Datasets
# ------------------------------------------------------------------------------
!ai-model-lineage-tracker/dataset/git_commits/features_v1.json
!ai-model-lineage-tracker/dataset/git_commits/processed_commits_v2.json
!ai-model-lineage-tracker/dataset/git_commits/raw_commits_axios.json

# ------------------------------------------------------------------------------
# 10. Blockchain Smart Contracts
# ------------------------------------------------------------------------------
!contracts/
!contracts/*.sol

# ------------------------------------------------------------------------------
# 11. Frontend Source
# ------------------------------------------------------------------------------
!frontend/src/
!frontend/src/**

# ------------------------------------------------------------------------------
# 12. Explicit Provenance / Integrity Files
# ------------------------------------------------------------------------------
!metadata.json
!model_integrity.json
!blockchain_registration_payload.json
!blockchain_registration.json

# Always exclude Python generated bytecode, including inside tracked source trees
**/__pycache__/
**/*.py[cod]

# Large generated Git Intelligence datasets
ai-model-lineage-tracker/dataset/git_commits/raw_commits.json
ai-model-lineage-tracker/dataset/git_commits/raw_commits_axios.json
ai-model-lineage-tracker/dataset/git_commits/processed_commits.json
ai-model-lineage-tracker/dataset/git_commits/processed_commits_v2.json
# Hardhat build artifacts
artifacts/
cache/
**/artifacts/
**/cache/
